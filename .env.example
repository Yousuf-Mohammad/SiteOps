# Read by docker-compose.yml and passed to the web container as the acting
# fake-auth identity (there is no real auth — see README "Fake auth").
#
# The api container seeds on startup and prints the generated ids. Copy this
# file to .env, then fill in the roadco org id and a user id from:
#
#   docker compose logs api | grep "org="
#
# ...and apply them with `docker compose up -d web`.
# Re-sync after `docker compose down -v`, which reseeds with new ids.

NEXT_PUBLIC_FAKE_ORG_ID=
NEXT_PUBLIC_FAKE_USER_ID=
